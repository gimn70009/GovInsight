OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANALYSIS_TIMEOUT_SECONDS=180
PROPOSAL_MODEL=gpt-5-mini
PROPOSAL_TIMEOUT_SECONDS=180
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_TEXT_CHARS=40000
ANALYSIS_RESULT_MAX_ATTEMPTS=3
ZIP_MAX_ENTRY_COUNT=20
ZIP_MAX_UNCOMPRESSED_SIZE_BYTES=104857600

# Submission brief extraction, independent of proposal eligibility (uses OPENAI_API_KEY)
# 메일의 회사 분석 요약: 외부 전송 승인 후 별도 활성화 (기본 비활성)
EMAIL_REVIEW_ENABLED=false
REPORT_BRIEF_ENABLED=true
REPORT_BRIEF_MODEL=gpt-5-mini
REPORT_BRIEF_REASONING_EFFORT=low
REPORT_BRIEF_TIMEOUT_SECONDS=30
# Batch base budget; distinct cache misses scale it up to the maximum below.
REPORT_BRIEF_TOTAL_TIMEOUT_SECONDS=60
# At most 90 seconds, leaving 30 seconds before backend recovery reclaims the job.
REPORT_BRIEF_MAX_TOTAL_TIMEOUT_SECONDS=90
REPORT_BRIEF_CONCURRENCY=3
REPORT_BRIEF_MAX_TEXT_CHARS=16000
REPORT_BRIEF_CACHE_TTL_SECONDS=86400

# Participation eligibility: one bounded extraction, no separate review or paid retry.
PARTICIPATION_REWRITE_MODEL=gpt-5-nano
PARTICIPATION_REWRITE_REASONING_EFFORT=minimal

# HWP/HWPX/PDF VLM OCR: shared OPENAI_API_KEY; no new native OCR extensions.
# Prefer one submission page + one eligibility/exclusion page; shared page is called once.
# HWP/HWPX use the explicitly installed local WASM renderer and existing Chromium.
# Each notice gets up to 2 files x 2 pages (4 calls); ZIP entries count as files.
# Failed requests count; no paid retries. Seven notices allow up to 28 OCR calls.
VLM_OCR_ENABLED=true
VLM_OCR_MODEL=gpt-5-mini
VLM_OCR_MAX_PAGES_PER_FILE=2
VLM_OCR_MAX_FILES_PER_DOCUMENT=2
VLM_OCR_MAX_CALLS_PER_DOCUMENT=4
# Separate wall-clock deadlines per page and for all selected pages of a file.
VLM_OCR_PAGE_TIMEOUT_SECONDS=120
VLM_OCR_TIMEOUT_SECONDS=240
VLM_OCR_MAX_OUTPUT_TOKENS=4096

# Optional local Korean TTF; defaults to Windows Fonts/malgun.ttf.
HWP_PDF_FONT_PATH=
