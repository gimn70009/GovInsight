spring.application.name=backend

# Oracle Database Free example
spring.datasource.url=${DB_URL:jdbc:oracle:thin:@localhost:1521/XEPDB1}
spring.datasource.username=${DB_USERNAME:govinsight}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# Local development only. Use validate after creating the schema.
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:update}
spring.jpa.open-in-view=false

# Generate with: openssl rand -base64 32
app.jwt.secret=${JWT_SECRET}
app.jwt.access-token-expiration=${JWT_ACCESS_TOKEN_EXPIRATION:1h}

# Creates the first local administrator only when enabled and absent.
app.local-admin.enabled=${LOCAL_ADMIN_ENABLED:false}
app.local-admin.login-id=${LOCAL_ADMIN_LOGIN_ID:admin}
app.local-admin.password=${LOCAL_ADMIN_PASSWORD:}

# Python monitoring API
app.python-monitoring.base-url=${PYTHON_MONITORING_BASE_URL:http://localhost:8000}
app.python-monitoring.connect-timeout=${PYTHON_MONITORING_CONNECT_TIMEOUT:3s}
app.python-monitoring.read-timeout=${PYTHON_MONITORING_READ_TIMEOUT:5s}
# OpenAPI / Swagger UI
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.groups-order=asc
springdoc.swagger-ui.operations-sorter=method
springdoc.swagger-ui.tags-sorter=alpha
# Telegram final report delivery after completed manual and scheduled runs.
# Enabled/chat-id are defaults until an administrator saves /telegram settings.
# The bot token always remains server-side.
app.telegram.enabled=${TELEGRAM_ENABLED:false}
app.telegram.bot-token=${TELEGRAM_BOT_TOKEN:}
app.telegram.chat-id=${TELEGRAM_CHAT_ID:}
app.telegram.recipient-name=${TELEGRAM_RECIPIENT_NAME:}
app.telegram.connect-timeout=${TELEGRAM_CONNECT_TIMEOUT:3s}
app.telegram.read-timeout=${TELEGRAM_READ_TIMEOUT:10s}
# Enable on only one server per bot; replies to new private /start messages.
app.telegram.commands.enabled=${TELEGRAM_COMMANDS_ENABLED:false}

# Gmail or Naver SMTP. Keep app passwords in environment/local ignored configuration.
app.email.provider=${EMAIL_PROVIDER:GMAIL}
app.email.username=${EMAIL_USERNAME:}
app.email.password=${EMAIL_PASSWORD:}
app.email.sender-name=${EMAIL_SENDER_NAME:GovInsight}
